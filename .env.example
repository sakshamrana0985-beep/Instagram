# Telegram — message @BotFather on Telegram to create a bot and get a token
TELEGRAM_BOT_TOKEN=

# Gemini — aistudio.google.com
GEMINI_API_KEY=

# Groq — console.groq.com (Whisper fallback transcription)
GROQ_API_KEY=

# Supabase — supabase.com, project settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# Apify — apify.com (Instagram reel scraping)
APIFY_TOKEN=

# --- tests only ---------------------------------------------------------
